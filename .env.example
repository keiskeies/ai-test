# 复制为 backend/.env（不入库）；键前缀 TP_
TP_ENV=dev
# 除进 Celery 导体：worker 的默认队列名 = "tp." + TP_ENV（D10/R118 分道，见 config.py 的
# task_queue 注释）。演示用一个 dev，发消息与起 worker 都别动这个键；并发跑门禁/脚本的
# lane 由测试套件各自设（pytest conftest 钉 test、e2e playwright 钉 e2e、verify_worker 每次
# 起一个独立 verify{ts}）。「常驻演示 worker 抢走测试任务」从此物理上不可能（R118 根治），
# 不用再为跑门禁专门去停手工起的 worker。
TP_DB_URL=mysql+asyncmy://root:CHANGE_ME@db.internal.test:3306/testpilot?charset=utf8mb4
TP_REDIS_URL=redis://:CHANGE_ME@db.internal.test:16379/6
TP_SECRET_KEY=CHANGE_ME_random_32b
TP_FERNET_KEY=
TP_BOOTSTRAP_ACCOUNT=admin
TP_BOOTSTRAP_PASSWORD=
TP_MODEL_SEED_BASE_URL=http://127.0.0.1:9000/v1
TP_MODEL_SEED_NAME=fundgpt-coder-next
TP_ARTIFACTS_DIR=backend/data/artifacts
# 执行链档位（R42）：默认 celery——场景执行真的走 worker（D5）。
# celery：enqueue 经 Redis 投给 worker（起法：celery -A app.worker:celery_app worker --pool=solo -l info）；
#         broker 连不上 → 503 executor_unavailable，不会偷偷改走本地。
# inline：同进程跑同一份引擎，供 pytest 与「不想开 worker 的单机演示」。演示/生产别设这个。
TP_EXEC_MODE=celery
# adb 二进制路径（1D，§5.4）。留空 = 依次找 PATH 里的 adb、再退 Android SDK 常见路径；
# 全都找不到 = 设备服务返带本键指引的人话错误（响亮，绝不装死、不假在线）。
# 本机实测 adb **不在 PATH**（在 %LOCALAPPDATA%\Android\Sdk\platform-tools\），所以
# 要演示 ADB 设备面就得显式设这一行——这也是 1D 演示手册手持路径的第一步。
# 单测/e2e 不需要它：假设备 fixture 自己生成 adb 可执行并注入 settings.adb_path。
TP_ADB_PATH=
