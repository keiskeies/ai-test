{
  "openapi": "3.0.1",
  "info": { "title": "Petstore", "version": "1.0.0" },
  "servers": [{ "url": "https://petstore.example.com/v1" }],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "列出宠物",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "example": 20 } },
          { "name": "X-Tenant", "in": "header", "schema": { "type": "string", "default": "t1" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "operationId": "createPet",
        "summary": "创建宠物",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getPet",
        "summary": "查询宠物",
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "operationId": "deletePet",
        "summary": "删除宠物",
        "responses": { "204": { "description": "gone" } }
      }
    },
    "/pets/{petId}/photos": {
      "post": {
        "operationId": "uploadPhoto",
        "summary": "上传宠物照片（体引用外部文档）",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "https://evil.example.com/common.yaml#/Photo" } }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "小白" },
          "tag": { "type": "string" }
        }
      }
    }
  }
}
